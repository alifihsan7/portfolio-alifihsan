---
import Base from "../layouts/Base.astro";
import { getProjects } from "../data";
import { useT, href, type Lang } from "../i18n/ui";

interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const t = useT(lang);
const projects = getProjects(lang);
const idx = projects.findIndex((x) => x.id === id);
const p = projects[idx];
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
const cat = (c: string) => t.categories[c] ?? c;

const tools = [...(p.tools ?? []), ...(p.technology ?? [])].join(", ");
const facts = [
  [t.factLabels.role, p.role],
  [t.factLabels.year, p.year],
  [t.factLabels.team, p.team],
  [t.factLabels.platform, p.platform],
  [t.factLabels.tools, tools],
].filter(([, v]) => v);
const links = (p.links ?? []).filter((l) => l.public); // private links stay hidden
const shots = (p.gallery ?? []).filter((g) => !("phone" in g && g.phone));
const phones = (p.gallery ?? []).filter((g) => "phone" in g && g.phone);
const stats = "stats" in p ? p.stats : [];
const isPlain = (v: string) => /^\d+$/.test(v);
const showPager = projects.length > 1;
---

<Base title={`${p.name} · Alif Ihsan`} description={p.lede || p.description} ogType="article">
  <a class="back" href={href(lang, "/") + "#work"}><span aria-hidden="true">←</span> {t.back}</a>

  <article class="detail">
    <header class="detail-head">
      <div class="meta">
        <span>{p.category.map(cat).join(" / ")}</span>
        {p.type && <span>{t.types[p.type] ?? p.type}</span>}
        {p.year && <span>{p.year}</span>}
      </div>
      <h1 class="title">{p.name}</h1>
      <p class="lede">{p.lede || p.description}</p>
      {links.length > 0 && (
        <div class="cta">
          {links.map((l) => (
            <a class="btn primary" href={l.url} target="_blank" rel="noopener">{l.label} <span class="arr" aria-hidden="true">↗</span></a>
          ))}
        </div>
      )}
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </header>

    {shots.length > 0 && (
      <div class="gallery">
        {shots.map((g, i) => (
          <figure class="reveal" style={`--d:${i % 2}`}>
            <button class="zoom" type="button" data-zoom data-caption={g.caption} aria-label={`${t.enlarge}${g.caption}`}>
              <img
                src={g.src}
                alt={g.alt}
                width="1280"
                height="800"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </button>
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {phones.length > 0 && (
      <div>
        <p class="label">{t.mobileVersion}</p>
        <div class="phones">
          {phones.map((g, i) => (
            <figure class="reveal" style={`--d:${i % 3}`}>
              <button class="zoom" type="button" data-zoom data-caption={g.caption} aria-label={`${t.enlarge}${g.caption}`}>
                <img
                  src={g.src}
                  alt={g.alt}
                  width="390"
                  height="844"
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}

    {(p.sections ?? []).map((s) => (
      <div class="prose reveal">
        <h2>{s.h}</h2>
        <div>{s.p.map((t) => <p>{t}</p>)}</div>
      </div>
    ))}

    {stats.length > 0 && (
      <div class="stats">
        {stats.map((s, i) => (
          <div class="reveal" style={`--d:${i}`}>
            <div class="stat-k">{s.k}</div>
            <div class="stat-v" data-count={isPlain(s.v) ? s.v : undefined}>{s.v}</div>
            <div class="stat-n">{s.n}</div>
          </div>
        ))}
      </div>
    )}

    {showPager && (
      <nav class="pager" aria-label={t.morePager}>
        <a href={href(lang, `/work/${prev.id}`)}><span class="dir">{t.prev}</span><span class="nm">{prev.name}</span></a>
        <a class="next" href={href(lang, `/work/${next.id}`)}><span class="dir">{t.next}</span><span class="nm">{next.name}</span></a>
      </nav>
    )}
  </article>
</Base>
