---
import Base from "../layouts/Base.astro";
import WorkRow from "../components/WorkRow.astro";
import Timeline from "../components/Timeline.astro";
import { getProjects } from "../data";
import { useT, href, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const projects = getProjects(lang);
const cat = (c: string) => t.categories[c] ?? c;

const name = "Alif Ihsan".split(" ");
// Filter chips, each with its project count. A project can belong to more than one category.
const categories = ["All", ...new Set(projects.flatMap((p) => p.category))];
const label = (c: string) => (c === "All" ? t.all : cat(c));
const countOf = (c: string) => (c === "All" ? projects.length : projects.filter((p) => p.category.includes(c)).length);
const showFilters = projects.length > 1;

// Work summary, counted from the data. A project can belong to more than one category.
const counts = new Map<string, number>();
projects.forEach((p) => p.category.forEach((c) => counts.set(c, (counts.get(c) ?? 0) + 1)));
const workSummary = [...counts].sort((a, b) => b[1] - a[1]).map(([c, n]) => cat(c) + " " + n).join(" · ");
const slides = projects.filter((p) => p.assets?.[0]);
---

<Base>
  <div class="hero" id="home" data-hero>
    <div class="hero-left">
      <p class="eyebrow">{t.eyebrow}</p>
      <p class="hello">
        <span class="vh">{t.hi}</span>
        <span class="hello-t" aria-hidden="true">{[...t.hi].map((c, i) => <span class="hc" style={"--i:" + i}>{c}</span>)}</span>
        <span class="wave" aria-hidden="true">👋</span>
      </p>
      <div class="name">
        <h1 aria-label="Alif Ihsan">
          {name.map((w, wi) => (
            <span class="word" aria-hidden="true">{[...w].map((c, ci) => <span class="ch" style={"--i:" + (wi * 5 + ci)}>{c}</span>)}</span>
          ))}
        </h1>
      </div>
      <p class="hero-role" data-typed={t.typed.join("|")} aria-hidden="true">
        <b>&gt;</b> <span class="t">{t.typed[0]}</span><span class="caret"></span>
      </p>
      <p class="lede">{t.lede}</p>
      <div class="cta">
        <a class="btn primary" href="#work">{t.viewWork} <span class="arr" aria-hidden="true">↓</span></a>
        <a class="btn" href="#experience">{t.seeExperience}</a>
      </div>
    </div>

    <aside class="hero-right" aria-label={t.selected}>
      {slides.length > 0 && (
        <div class="showcase" data-showcase aria-label={t.selected}>
          <div class="deck">
            {slides.map((p, i) => (
              <a
                class="s"
                style={"--pos:" + Math.min(i, 3)}
                href={href(lang, "/work/" + p.id)}
                tabindex={i === 0 ? 0 : -1}
                data-name={p.name}
                aria-label={t.openProject + p.name}
              >
                <img
                  src={p.assets[0]}
                  alt={p.name + t.preview}
                  width="1280"
                  height="800"
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={i === 0 ? "high" : undefined}
                />
              </a>
            ))}
          </div>
          <div class="shot-cap">
            <span class="shot-name" data-showcase-name>01 · {slides[0].name}</span>
            <span class="dots" aria-hidden="true">{slides.map((_, i) => <i class={i === 0 ? "on" : ""}></i>)}</span>
          </div>
        </div>
      )}
    </aside>

    <dl class="facts">
      <div><dt>{t.facts.education}</dt><dd>{t.facts.educationV}</dd></div>
      <div><dt>{t.facts.focus}</dt><dd>{t.facts.focusV}</dd></div>
      <div><dt>{t.facts.learning}</dt><dd>{t.facts.learningV}</dd></div>
      <div><dt>{t.facts.currently}</dt><dd>{t.facts.currentlyV}</dd></div>
    </dl>
  </div>

  <section id="work" aria-labelledby="work-h">
    <div class="head reveal">
      <div class="head-l">
        <p class="eyebrow">01</p>
        <h2 id="work-h">{t.workTitle}</h2>
      </div>
      <p class="sub">{projects.length} {projects.length === 1 ? t.project : t.projects}. {workSummary}.</p>
    </div>

    {showFilters && (
      <div class="filters" role="group" aria-label={t.filterAria}>
        {categories.map((c) => (
          <button class="chip" type="button" data-c={c} data-label={label(c)} aria-pressed={c === "All"}>{label(c)} <span class="n">{countOf(c)}</span></button>
        ))}
      </div>
    )}

    <p class="vh" role="status" aria-live="polite" data-filter-status data-all={t.showingAll} data-some={t.showing} data-one={t.project} data-many={t.projects}></p>

    {projects.length === 0 ? (
      <div class="empty">
        <h3>{t.emptyTitle}</h3>
        <p>{t.emptyText}</p>
      </div>
    ) : (
      <div class="rows">
        {projects.map((p, i) => <WorkRow project={p} index={i} lang={lang} />)}
      </div>
    )}
  </section>

  <section id="experience" aria-labelledby="exp-h">
    <div class="head reveal">
      <div class="head-l">
        <p class="eyebrow">02</p>
        <h2 id="exp-h">{t.expTitle}</h2>
      </div>
      <p class="sub">{t.expSub}</p>
    </div>
    <Timeline lang={lang} />
  </section>

  <section id="about" aria-labelledby="about-h">
    <div class="head reveal">
      <div class="head-l">
        <p class="eyebrow">03</p>
        <h2 id="about-h">{t.aboutTitle}</h2>
      </div>
    </div>
    <div class="about">
      <div class="wide reveal">
        <p class="label">{t.background}</p>
        <p>{t.backgroundText}</p>
      </div>
      <div class="reveal">
        <p class="label">{t.education}</p>
        <p>{t.educationLines[0]}<br />{t.educationLines[1]}<br /><span class="todo">{t.classOf}</span></p>
      </div>
      <div class="reveal" style="--d:1">
        <p class="label">{t.interests}</p>
        <ul>{t.interestList.map((i) => <li class="pill">{i}</li>)}</ul>
      </div>
      <div class="reveal skills" style="--d:2">
        <p class="label">{t.skills}</p>
        <div class="skill-groups">
          <div><p class="sub-label">{t.design}</p><ul>{t.designSkills.map((i) => <li class="pill">{i}</li>)}</ul></div>
          <div><p class="sub-label">{t.development}</p><ul><li class="pill">TypeScript</li><li class="pill">Python</li><li class="pill">PHP</li><li class="pill">JavaScript</li><li class="pill">HTML</li><li class="pill">CSS</li><li class="pill">React</li><li class="pill">Next.js</li><li class="pill">Tailwind CSS</li><li class="pill">Laravel</li><li class="pill">Flask</li><li class="pill">Streamlit</li><li class="pill">Supabase</li></ul></div>
        </div>
      </div>
      <div class="reveal" style="--d:3">
        <p class="label">{t.pastTools}</p>
        <ul><li class="pill">Figma</li><li class="pill">Canva</li><li class="pill">Adobe Premiere Pro</li></ul>
      </div>
      <div class="reveal" style="--d:4">
        <p class="label">{t.learningLabel}</p>
        <ul>{t.learningList.map((i) => <li class="pill">{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-h">
    <div class="head reveal">
      <div class="head-l">
        <p class="eyebrow">04</p>
        <h2 id="contact-h">{t.contactTitle}</h2>
      </div>
    </div>
    <div class="contact-box reveal">
      <p class="contact-big">{t.contactBig}</p>
      <p>
        <a class="btn primary" href="https://www.linkedin.com/in/alifihsan7/" rel="noopener" target="_blank">
          LinkedIn: alifihsan7 <span class="arr" aria-hidden="true">↗</span>
        </a>
      </p>
      <dl class="facts">
        <div><dt>{t.email}</dt><dd><a href="mailto:aliffihsann@gmail.com">aliffihsann@gmail.com</a></dd></div>
        <div><dt>{t.uniEmail}</dt><dd><a href="mailto:alifihsan@student.telkomuniversity.ac.id">alifihsan@student.telkomuniversity.ac.id</a></dd></div>
      </dl>
    </div>
  </section>
</Base>
