---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
}

const {
  title = "Alif Ihsan",
  description = "Portfolio of Alif Ihsan, an Informatics student at Telkom University working across UI/UX design and software development, now learning data and AI.",
  ogType = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b1426" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alif Ihsan" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="spot" aria-hidden="true"></div>
    <div class="guides" aria-hidden="true"></div>
    <div class="readout" aria-hidden="true">X 0000 · Y 0000</div>
    <div class="peek" aria-hidden="true"><img alt="" /></div>

    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Alif Ihsan, home"><i></i>Alif Ihsan</a>
        <nav aria-label="Main">
          <a href="/#home" data-nav="home">Home</a>
          <a href="/#work" data-nav="work" aria-current={!isHome ? "true" : undefined}>Work</a>
          <a href="/#experience" data-nav="experience">Experience</a>
          <a href="/#about" data-nav="about">About</a>
          <a href="/#contact" data-nav="contact">Contact</a>
          <button class="theme" id="theme-toggle" type="button" aria-label="Switch colour theme">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main" tabindex="-1">
      <slot />
      <footer>
        <span>© 2026 Alif Ihsan</span>
        <span>Bandung, Indonesia</span>
        <a class="to-top" href="#main">Back to top ↑</a>
      </footer>
    </main>

    <dialog class="lb" id="lightbox" aria-label="Image viewer">
      <div class="lb-in">
        <div class="lb-stage"><img alt="" /></div>
        <p class="lb-cap"></p>
      </div>
      <button class="x" type="button" aria-label="Close">✕</button>
      <button class="p" type="button" aria-label="Previous image">←</button>
      <button class="n" type="button" aria-label="Next image">→</button>
    </dialog>

    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
