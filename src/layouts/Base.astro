---
import "../styles/global.css";
import { langOf, useT, href, swapPath, type Lang } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
}

const lang: Lang = langOf(Astro.url.pathname);
const t = useT(lang);
const other: Lang = lang === "en" ? "id" : "en";

const { title = t.siteTitle, description = t.siteDescription, ogType = "website" } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL(swapPath(Astro.url.pathname, "en"), Astro.site);
const idUrl = new URL(swapPath(Astro.url.pathname, "id"), Astro.site);
const isHome = Astro.url.pathname === href(lang, "/");
const home = href(lang, "/");
const ogImage = new URL("/og.png", Astro.site);

const siteUrl = Astro.site ? Astro.site.toString() : "https://portfolio.alifihsan.my.id/";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alif Ihsan",
  url: siteUrl,
  jobTitle: lang === "id" ? "Desainer UI/UX & Mahasiswa Informatika" : "UI/UX Designer & Informatics Student",
  description: description,
  email: "mailto:aliffihsann@gmail.com",
  sameAs: [
    "https://www.linkedin.com/in/alifihsan7/",
    "https://github.com/alifihsan7"
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Telkom University"
  },
  memberOf: {
    "@type": "Organization",
    name: "Advanced Software Engineering Laboratory"
  },
  knowsAbout: [
    "UI/UX Design",
    "Frontend Development",
    "TypeScript",
    "Python",
    "Figma"
  ]
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b1426" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alif Ihsan" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body data-lang={lang} data-home={home}>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="spot" aria-hidden="true"></div>
    <div class="guides" aria-hidden="true"></div>
    <div class="readout" aria-hidden="true">X 0000 · Y 0000</div>
    <div class="peek" aria-hidden="true"><img alt="" /></div>

    <header class="top">
      <div class="wrap">
        <a class="brand" href={home} aria-label={t.homeAria}><i></i>Alif Ihsan</a>
        <nav aria-label={t.navAria}>
          <a href={home + "#home"} data-nav="home">{t.nav.home}</a>
          <a href={home + "#work"} data-nav="work" aria-current={!isHome ? "true" : undefined}>{t.nav.work}</a>
          <a href={home + "#experience"} data-nav="experience">{t.nav.experience}</a>
          <a href={home + "#about"} data-nav="about">{t.nav.about}</a>
          <a href={home + "#contact"} data-nav="contact">{t.nav.contact}</a>
          <button class="theme" id="theme-toggle" type="button" aria-label={t.themeAria}>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="lang" href={swapPath(Astro.url.pathname, other)} hreflang={other} lang={other} aria-label={t.langAria} data-lang-switch>{t.langShort}</a>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main" tabindex="-1">
      <slot />
      <footer>
        <span>© 2026 Alif Ihsan</span>
        <span>{t.location}</span>
        <a class="to-top" href="#main">{t.toTop}</a>
      </footer>
    </main>

    <dialog class="lb" id="lightbox" aria-label={t.lightbox.label}>
      <div class="lb-in">
        <div class="lb-stage"><img alt="" /></div>
        <p class="lb-cap"></p>
      </div>
      <button class="x" type="button" aria-label={t.lightbox.close}>✕</button>
      <button class="p" type="button" aria-label={t.lightbox.prev}>←</button>
      <button class="n" type="button" aria-label={t.lightbox.next}>→</button>
    </dialog>

    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
