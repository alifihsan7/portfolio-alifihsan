---
import { projectTech, type Project } from "../data";
import { useT, href, type Lang } from "../i18n/ui";

interface Props {
  project: Project;
  index: number;
  lang: Lang;
}
const { project: p, index, lang } = Astro.props;
const t = useT(lang);
const thumb = p.assets?.[0];
const meta = [p.category.map((c) => t.categories[c] ?? c).join(" / "), p.role || t.na, p.type && (t.types[p.type] ?? p.type)].filter(Boolean);
---

<a
  class="row reveal"
  style={`--d:${index}`}
  href={href(lang, `/work/${p.id}`)}
  data-cats={p.category.join("|")}
  data-peek={thumb}
  aria-label={t.openProject + p.name}
>
  <span class="r-num">{String(index + 1).padStart(2, "0")}</span>
  <span class="r-title">{p.name}</span>
  {thumb && <span class="r-mini" aria-hidden="true"><img src={thumb} alt="" loading="lazy" decoding="async" width="1280" height="800" /></span>}
  <span class="r-side">
    <span class="r-year">{p.year || ""}</span>
    <span class="r-arr" aria-hidden="true">↗</span>
  </span>
  <span class="r-body">
    <span class="r-desc">{p.description || t.na}</span>
    <span class="r-meta">{meta.map((t) => <span>{t}</span>)}</span>
    <span class="tech">{projectTech(p) || t.na}</span>
    {thumb && <span class="r-thumb"><img src={thumb} alt={p.name + t.preview} loading="lazy" decoding="async" width="1280" height="800" /></span>}
  </span>
</a>
